# Kunci Google. JANGAN PERNAH masuk repo.
.secrets/

# Profil Chrome - berisi SESI LOGIN WHATSAPP tiap brand. Kalau ini bocor,
# orang lain bisa memposting Status atas nama brand.
.chrome/

# Hasil unduhan dari Drive, bisa ratusan MB
unduhan/

# Bahan & hasil kurasi visual: contact sheet + PDF, bisa puluhan MB
kurasi/
kurasi_frames/

# Indeks Drive, disusun ulang sendiri lewat 'python wa.py indeks'
indeks_drive.json

# Catatan jalan
riwayat.log
server.log

# Ekspor/preview laporan yang longgar - hasil kurasi disimpan HANYA sebagai
# PDF di kurasi/, jangan sebagai gambar lepas yang bikin folder penuh.
lap_*.png
# Screenshot sementara buat memeriksa tampilan web - bukan bagian aplikasi.
app*.png

__pycache__/
*.pyc

# Frontend React: dependensi & hasil build, jangan masuk repo
web/node_modules/
web/dist/

# PDF besar di _recek (bahan recek, puluhan MB) - jangan masuk repo & jangan
# ikut discan Claude Code. Script .py di _recek tetap bisa ditrack.
_recek/*.pdf

# Model whisper (ubah suara narasi jadi teks), ~190 MB - unduh ulang bila hilang
model/
